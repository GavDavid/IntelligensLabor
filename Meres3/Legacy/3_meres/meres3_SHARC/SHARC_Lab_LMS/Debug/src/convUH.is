#line 26 "../src/convUH.asm"

.SECTION/PM seg_pmda;
.var mode1MentUH;



.SECTION/PM seg_pmco;
.global _conv_asm_int;


_conv_asm_int:

;



















 



























 





 

r0 = mode1;
pm(mode1MentUH) = r0;

	bit set MODE1 (0x01000000);				 
	bit set MODE1 (0x00200000);				 

m4  = 2;   
m12 = 2;   

r2 = dm(1, i6);  
 
b12 = r4;
l12 = r2;

b4 = r12;
l4 = r2;
i4 = r8;
 
  
 
		
	r2 = ashift r2 by -1;
	r2 = r2 - 1;  

	lcntr = 8, do DAChannelsInt until lce;
		 
 		f8  = 0.0;	
		f12 = 0.0;
		f0  = dm(i4,m4) , f4 = pm(i12,m12);  
		
		lcntr = r2, do convLoop1 until lce;
convLoop1:	f12 = f0 * f4,	f8 = f8 + f12, f0 = dm(i4,m4), f4 = pm(i12,m12);
			f12 = f0 * f4,	f8 = f8 + f12;
			f8 = f8 + f12;
 
			f0 = s8;
			f4 = f0 + f8;	 
		
	bit clr MODE1 (0x00200000);				 
		r0 = i4;   
		i4 = dm(2, i6);	 
		dm(i4,1) = f4;	 
		r4 = i4;		 
		dm(2,i6) = r4;	 
	bit set MODE1 (0x00200000);				 
		
		 
		r4 = b4;  
		r8 = l4;
		r8 = r8 + 1;	 
		r4 = r4 + r8;	 
		b4 = r4;		 
		i4 = r0;		 
		m4 = r8;		 
		modify(i4,m4);  
		m4 = 2;			 
DAChannelsInt: nop;


 

























 

r2 = pm(mode1MentUH);  
mode1 = r2;  
l12 = 0;  
l4  = 0;  

i12=dm(m7,i6); jump (m14,i12) (db); rframe; nop;

_conv_asm_int.end: nop;


