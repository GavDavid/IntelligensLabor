#line 18 "C:\Analog Devices\CrossCore Embedded Studio 2.11.1\SHARC\include\def21364.h"


#line 27 "../src/conv.asm"

.SECTION/PM seg_pmda;

.var mode1Ment;


.SECTION/PM seg_pmco;
.global _conv_asm;


_conv_asm:

;


r0 = mode1;
pm(mode1Ment) = r0;



	bit set MODE1 (0x01000000);				 
	bit set MODE1 (0x00200000);				 

m4  = 2;   
m12 = 2;   

r2 = dm(1, i6);  
 
b12 = r4;
l12 = r2;

b4 = r12;
l4 = r2;
i4 = r8;
  
 
 
 		f8 = 0.0;	
		f12 = 0.0;
		f0 = dm(i4,m4) , f4 = pm(i12,m12);  
		
		r2 = ashift r2 by -1;
		r2 = r2 - 1;  
		lcntr = r2, do convLoop until lce;
convLoop:	f12 = f0 * f4,	f8 = f8 + f12, f0 = dm(i4,m4), f4 = pm(i12,m12);
	   	f12 = f0 * f4,	f8 = f8 + f12;
		f8 = f8 + f12;
		
		f0 = s8;
		f0 = f0 + f8;




 
r2 = pm(mode1Ment);
mode1 = r2;
l12 = 0;
l4  = 0;

i12=dm(m7,i6); jump (m14,i12) (db); rframe; nop;

_conv_asm.end: nop;


