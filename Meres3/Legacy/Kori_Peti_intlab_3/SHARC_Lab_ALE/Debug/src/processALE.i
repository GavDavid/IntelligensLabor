# 2 "..\\src\\processALE.c"
int	LEDval = 0;

int flagTest(int);







#pragma align 4
float __pm coefw[100];

#pragma align 4
float __dm x[100+1];

#pragma align 4
float __dm delay[1];

#pragma optimize_for_speed

int i = 0;
int j = 0;
int k = 0;
int kd;

float mu = 0.1;

float xDCfilt      = 0.0;
float xDCfiltParam = 0.99999;

float y;
float ref;

float y_est;
float e;

int   channelToOutput4    = 4;
int   channelToOutput4Old = 4;

void process(void){
    
    isProcessing = 1;

    setDAIproc();    

    y = leftIn;
    
    xDCfilt = (xDCfiltParam)*xDCfilt + (1-xDCfiltParam)*y;
    y = y - xDCfilt;
  
    kd=(k+1)%1;
	x[i] = delay[kd]; 
	delay[k] = y;
	
	
	
    if (i==0){
	    x[100] = x[0]; 
    }

	y_est = conv_asm_var(coefw, &(x[i]), x, 100+1, 100);	
	
	y_est = 0.0;
	
	for(j=0; j<100; j++){
		y_est += coefw[j] * x[(i+j)%100];
	}
	
	e = y - y_est;
	
	for(j=0; j<100; j++){
		coefw[j] = coefw[j] + mu * x[(i+j)%100] * e;
	}
	    
    leftOut1  = y;  
	rightOut1 = y;
	
	leftOut2  = y_est;  
	rightOut2 = y_est;
	
	leftOut3  = e;  
	rightOut3 = e;
	
	leftOut4  = x[i];  
	rightOut4 = x[i];

    if (i <= 0){
		i = 100-1;
    } else { 
	    i--;
    }
	    
	if (k <= 0){
		k = 1-1;
    } else { 
	    k--;
    }

    


	
	
    channelToOutput4Old = channelToOutput4;
    
    
    if (flagTest((0x00000004))!=0){  
    	channelToOutput4 = 4;
    }
    
    
    if (flagTest((0x00000010))!=0){  
    	channelToOutput4 = 3;
    }
    
    
    if (readDAIpin(1<<18)>0) {  
    	channelToOutput4 = 2;
	}
    
    
    if (readDAIpin(1<<19)>0) {  
    	channelToOutput4 = 1;
	}
	
	
    LEDval &= ~(1<<(4-channelToOutput4Old));
    LEDval |=  (1<<(4-channelToOutput4)   );
    
    
    if (1 == channelToOutput4){
        rightOut4 = rightOut1;
         leftOut4 =  leftOut1;
    }
    
    if (2 == channelToOutput4){
        rightOut4 = rightOut2;
         leftOut4 =  leftOut2;
    }
    
    if (3 == channelToOutput4){
        rightOut4 = rightOut3;
         leftOut4 =  leftOut3;
    }
    



float satOut = 0.90;
	if (rightOut1< -satOut) {rightOut1= -satOut;} if (rightOut1>satOut) {rightOut1=satOut;};
	if (leftOut1< -satOut) {leftOut1= -satOut;} if (leftOut1>satOut) {leftOut1=satOut;};
	if (rightOut2< -satOut) {rightOut2= -satOut;} if (rightOut2>satOut) {rightOut2=satOut;};
	if (leftOut2< -satOut) {leftOut2= -satOut;} if (leftOut2>satOut) {leftOut2=satOut;};
	if (rightOut3< -satOut) {rightOut3= -satOut;} if (rightOut3>satOut) {rightOut3=satOut;};
	if (leftOut3< -satOut) {leftOut3= -satOut;} if (leftOut3>satOut) {leftOut3=satOut;};
	if (rightOut4< -satOut) {rightOut4= -satOut;} if (rightOut4>satOut) {rightOut4=satOut;};
	if (leftOut4< -satOut) {leftOut4= -satOut;} if (leftOut4>satOut) {leftOut4=satOut;};
		
    clrDAIproc();    

    
    
    isProcessing = 0;
}



void handle_LED(int led_value){

    *((volatile unsigned int *) 0x1800)=0;

    *((volatile unsigned int *) 0x1818)=(int)&led_value;  
    *((volatile unsigned int *) 0x1819)=1;
    *((volatile unsigned int *) 0x181a)=1;
    *((volatile unsigned int *) 0x1811)=1;
    *((volatile unsigned int *) 0x1812)=1;
    *((volatile unsigned int *) 0x1810)=0x400000;   

    *((volatile unsigned int *) 0x1800)=(0x00000200)|(0x00000040)|(0x00000002|0x00000004|0x00000020)|(0x00000100)|(0x00000001);
}


int flagTest(int mask){
	int tmpANC0;
			
	asm volatile(
		" %0 = flags;\n\t"
   		: "=&d" (tmpANC0)
   		:
   		: 
   		);
return (   (tmpANC0&mask)    );   	
}




