#define NUMBER_OF_LEVELS 5

// Array for amps
fract possibleLevelValues[NUMBER_OF_LEVELS] = {
	#include "amps.dat"
};

int indeces[3] = {0};
section("L1_data_b") fract levels[3] = {0};



void setFrequencyParamBass(param_t* c){
    printf("Bass selected\n");
    *c = Bass;
}

void setFrequencyParamMid(param_t* c){
    printf("Mid selected\n");
    *c = Mid;
}

void setFrequencyParamHigh(param_t* c){
    printf("High selected\n");
    *c = High;
}



void decreaseLevel(param_t* frequencyParameter){
    if(indeces[*frequencyParameter] < NUMBER_OF_LEVELS - 1){
    indeces[*frequencyParameter]++;
    levels[*frequencyParameter] = possibleLevelValues[indeces[*frequencyParameter]];
    }
    else{
        printf("Limit reached\n");
    }
}

void increaseLevel(param_t* frequencyParameter){
    if(indeces[*frequencyParameter] > 0){
        indeces[*frequencyParameter]--;
        levels[*frequencyParameter] = possibleLevelValues[indeces[*frequencyParameter]];
    }
    else{
        printf("Limit reached\n");
    }
    setLeds
}


void setLeds(uint8_t index){
    switch(index){
        case 0:
            adi_gpio_Set(LED1_PORT, LED1_PIN | LED2_PIN | LED3_PIN | LED4_PIN | LED5_PIN);
            break;
        case 1:
            adi_gpio_Set(LED1_PORT, LED1_PIN | LED2_PIN | LED3_PIN | LED4_PIN);
            adi_gpio_Clear(LED5_PIN);
            break;
        case 2:
            adi_gpio_Set(LED1_PORT, LED1_PIN | LED2_PIN | LED3_PIN);
            LED5_PIN(LED5_PIN | LED4_PIN);
            break;
        case 3:
            adi_gpio_Set(LED1_PORT, LED1_PIN | LED2_PIN);
            LED5_PIN(LED5_PIN | LED4_PIN | LED3_PIN);
            break;
        case 4:
            adi_gpio_Set(LED1_PORT, LED1_PIN);
            LED5_PIN(LED5_PIN | LED4_PIN | LED3_PIN | LED2_PIN);
            break;
    }
}


