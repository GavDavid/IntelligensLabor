.SECTION/DOUBLEANY program;
.ALIGN 2;

start:
       
       
       
      .MESSAGE/SUPPRESS 5515;


 
.start_of_user_code_very_beginning:
       
       
.end_of_user_code_very_beginning:
 

       
       
      .EXTERN __disable_cplbs;
      .TYPE __disable_cplbs,STT_FUNC;
      CALL.X __disable_cplbs;

       
      R0.L = LO(0x81818181); R0.H = HI(0x81818181);

       
       
       
      .EXTERN ldf_stack_end;
      .TYPE ldf_stack_end,STT_OBJECT;
      SP.L = LO(ldf_stack_end); SP.H = HI(ldf_stack_end);
      USP = SP;

       
       
      [--SP] = R0;
      [--SP] = R0;

       
      FP = SP;

       
       
      SP += -12;

       
       
       
       
      R7 = 0;
      LC0 = R7;
      LC1 = R7;

       
       
      L0 = R7;
      L1 = R7;
      L2 = R7;
      L3 = R7;

       
       
       
      I0.L = LO(0xFFE01300); I0.H = HI(0xFFE01300);
      I1.L = LO(0xFFE00300); I1.H = HI(0xFFE00300);
      [I0] = R7;
      [I1] = R7;
      CSYNC;

       
       
      P0.L = LO(0xFFE02008); P0.H = HI(0xFFE02008);

       
      .EXTERN __nmi_int_dispatcher;
      .TYPE __nmi_int_dispatcher,STT_FUNC;
      R1.L = LO(__nmi_int_dispatcher); R1.H = HI(__nmi_int_dispatcher);
      [P0++] = R1;           

       
      .EXTERN __exc_dispatcher;
      .TYPE __exc_dispatcher,STT_FUNC;
      R1.L = LO(__exc_dispatcher); R1.H = HI(__exc_dispatcher);
      [P0++] = R1;           

       
       
      .EXTERN __cec_int_dispatcher;
      .TYPE __cec_int_dispatcher,STT_FUNC;
      R1.L = LO(__cec_int_dispatcher); R1.H = HI(__cec_int_dispatcher);
      P1 = 11;
      LSETUP (.ivt, .ivt) LC0 = P1;
.ivt:  [P0++] = R1;

       
       
       
       
       
      P1.L = LO(supervisor_mode); P1.H = HI(supervisor_mode);
      [P0] = P1;

       
      R1 = SYSCFG;

      BITSET (R1, 0x00000001);      

      SYSCFG = R1;

       
       
       
      R0 = ((1<<(0x0000000f))) (Z);
      .EXTERN __install_default_handlers;
      .TYPE __install_default_handlers,STT_FUNC;
      CALL.X __install_default_handlers;   
      R4 = R0;               

       
      .EXTERN __init_dispatch_tables;
      .TYPE __init_dispatch_tables,STT_FUNC;
      CALL.X __init_dispatch_tables;


 
.start_of_user_code1:
       
       
.end_of_user_code1:
 

       
       
       

       
       
      .MESSAGE/RESTORE 5515;

       
       
      STI R4;
      RAISE 15;              

       
      P0.L = LO(still_interrupt_in_ipend); P0.H = HI(still_interrupt_in_ipend);
      RETI = P0;

still_interrupt_in_ipend:
       
       
       
       
       
       
       
       
       
       
       
       
       
      .MESSAGE/SUPPRESS 1056 FOR 1 LINES;   
      RTI;

supervisor_mode:
      [--SP] = RETI;         

