#include "frame.h"
#include <stdfix.h>
#include "sin2pi_fx.h"

#define N 1024		    // number of data
section("L1_data_b") fract amplitudes[N] = {
#include "sine_lut_1024.dat"
};

#define FCLK 48000.0
#define FOUT 1000.0

//--------------------------------------------------------------------------//
// Function:	Process_Data()												//
//																			//
// Description: This function is called from inside the SPORT0 ISR every 	//
//				time a complete audio frame has been received. The new 		//
//				input samples can be found in the variables iChannel0LeftIn //
//				and iChannel0RightIn respectively. The processed data should//
// 				be stored in iChannel0LeftOut and iChannel0RightOut.		//
//--------------------------------------------------------------------------//
void Process_Data(void)
{
	static fract counter = -1;
	static fract indexMax;
	int cntrInt;

	fract outData;
	int outInt;

	indexMax = rbits(512);
	index = bitsr(phase * indexMax);

	outData = amplitudes[(N / 2) + index];
	outInt = bitsr(outData);

	cntrInt = bitsr(counter);
	cntrInt+= bitsr(phase);

	counter = rbits(cntrInt);


	iChannel0LeftOut  = (outInt << 8);

	iChannel0RightOut = iChannel0RightIn;
}
